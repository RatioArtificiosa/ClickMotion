{
  "name": "ms",
  "version": "0.1.0",
  "private": true,
  "description": "MS - Premium AI Website Prompts & Motion Assets. Production-grade prompt library for AI coding tools.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,mdx}\" \"content/**/*.{md,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mdx}\" \"content/**/*.{md,mdx}\"",
    "validate:prompts": "tsx scripts/validate-prompts.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "encode:backgrounds": "node scripts/encode-backgrounds-preview.mjs",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:manifest": "tsx scripts/generate-prompt-manifest.ts",
    "seed": "tsx scripts/seed.ts",
    "db:generate-types": "supabase gen types typescript --local > src/types/database-generated.ts",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
