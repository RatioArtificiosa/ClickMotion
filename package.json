    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.12.5",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0",
