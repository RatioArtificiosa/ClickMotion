# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Member auth (Auth.js + Google OAuth) — see docs/ops/GOOGLE_OAUTH_SETUP.md
# Generate secret: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: Auth.js also accepts these aliases
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_SECRET=
# AUTH_URL=http://localhost:3004
# AUTH_TRUST_HOST=true

# Paid members until Stripe→plan is fully wired (comma-separated emails)
PAID_MEMBER_EMAILS=

# Admin CMS (/admin) - required in production
ADMIN_PASSWORD=change-me
# Optional separate HMAC secret for session cookies (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=

# CMS data lives in data/cms/store.json (gitignored recommended for prod multi-instance use Supabase later)
# Member ledger: data/members/store.json (created on first Google sign-in)

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Email
RESEND_API_KEY=
